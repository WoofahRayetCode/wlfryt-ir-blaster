<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/remote_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/remote_text"
            android:textSize="26sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/vizio_model"
            android:textColor="@color/remote_accent"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/pointing_instruction"
            android:textColor="@color/remote_secondary_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/ir_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:accessibilityLiveRegion="polite"
            android:minLines="2"
            android:text="@string/status_checking"
            android:textColor="@color/remote_secondary_text"
            android:textSize="14sp" />

        <LinearLayout style="@style/RemoteRow">

            <Button
                android:id="@+id/power"
                style="@style/RemoteButton.Accent"
                android:text="@string/power" />

            <Button
                android:id="@+id/input"
                style="@style/RemoteButton"
                android:text="@string/input" />
        </LinearLayout>

        <LinearLayout style="@style/RemoteRow">

            <Button
                android:id="@+id/hdmi_1"
                style="@style/RemoteButton"
                android:text="@string/hdmi_1" />

            <Button
                android:id="@+id/hdmi_2"
                style="@style/RemoteButton"
                android:text="@string/hdmi_2" />
        </LinearLayout>

        <LinearLayout style="@style/RemoteCluster">

            <LinearLayout style="@style/DirectionRow">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/up"
                    style="@style/RemoteButton.Arrow"
                    android:contentDescription="@string/direction_up"
                    android:text="@string/arrow_up" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout style="@style/DirectionRow">

                <Button
                    android:id="@+id/left"
                    style="@style/RemoteButton.Arrow"
                    android:contentDescription="@string/direction_left"
                    android:text="@string/arrow_left" />

                <Button
                    android:id="@+id/ok"
                    style="@style/RemoteButton.Accent"
                    android:text="@string/ok"
                    tools:ignore="ButtonOrder" />

                <Button
                    android:id="@+id/right"
                    style="@style/RemoteButton.Arrow"
                    android:contentDescription="@string/direction_right"
                    android:text="@string/arrow_right" />
            </LinearLayout>

            <LinearLayout style="@style/DirectionRow">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/down"
                    style="@style/RemoteButton.Arrow"
                    android:contentDescription="@string/direction_down"
                    android:text="@string/arrow_down" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/RemoteRow">

            <Button
                android:id="@+id/back"
                style="@style/RemoteButton"
                android:text="@string/back" />

            <Button
                android:id="@+id/home"
                style="@style/RemoteButton"
                android:text="@string/home" />
        </LinearLayout>

        <LinearLayout style="@style/RemoteRow">

            <Button
                android:id="@+id/volume_down"
                style="@style/RemoteButton"
                android:contentDescription="@string/volume_down"
                android:text="@string/volume_down_short" />

            <Button
                android:id="@+id/mute"
                style="@style/RemoteButton"
                android:text="@string/mute" />

            <Button
                android:id="@+id/volume_up"
                style="@style/RemoteButton"
                android:contentDescription="@string/volume_up"
                android:text="@string/volume_up_short" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
